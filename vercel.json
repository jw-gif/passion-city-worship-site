{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/staff.html", "destination": "/#staff", "permanent": true },
    { "source": "/how-it-works.html", "destination": "/#how-it-works", "permanent": true },
    { "source": "/on-site.html", "destination": "/#on-site", "permanent": true },
    { "source": "/team-life.html", "destination": "/#team-life", "permanent": true },
    { "source": "/guidelines.html", "destination": "/#guidelines", "permanent": true },
    { "source": "/admin", "destination": "/", "permanent": false },
    { "source": "/admin/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/home.html" },
    { "source": "/:slug([a-z0-9-]+)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/static/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/content/fallback.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
